# All optional. Leave VITE_KEYCLOAK_URL empty to run everyone as a guest,
# and VITE_WS_URL empty to run the board solo. A deployed build ignores
# localhost URLs, so these defaults only take effect in local dev.
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=whiteboard
VITE_KEYCLOAK_CLIENT_ID=whiteboard-ui
VITE_WS_URL=ws://localhost:8080
